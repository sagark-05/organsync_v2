{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/donors/[id]",
      "regex": "^/api/donors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/donors/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/organs/[id]",
      "regex": "^/api/organs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/organs/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/patients/[id]",
      "regex": "^/api/patients/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/patients/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/donors",
      "regex": "^/api/donors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/donors(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/api/organs",
      "regex": "^/api/organs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/organs(?:/)?$"
    },
    {
      "page": "/api/patients",
      "regex": "^/api/patients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/patients(?:/)?$"
    },
    {
      "page": "/api/reference-data",
      "regex": "^/api/reference\\-data(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/reference\\-data(?:/)?$"
    },
    {
      "page": "/donors",
      "regex": "^/donors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/donors(?:/)?$"
    },
    {
      "page": "/organs",
      "regex": "^/organs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/organs(?:/)?$"
    },
    {
      "page": "/patients",
      "regex": "^/patients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/patients(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}