# Copy to .env.local and supply existing credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=organsync_v2
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Optional future MongoDB integration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=organsync_v2

# Writes are blocked by default and always blocked in production.
# For local fictional-data CRUD only, set true and supply a random token of 32+ characters.
# Enter the same token in the management page; it stays in memory, not browser storage.
ORGANSYNC_DEV_WRITES=false
ORGANSYNC_DEV_WRITE_TOKEN=
