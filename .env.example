# Copy to .env.local and supply existing credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=organsync_v2
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Atlas URI: replace placeholder using your existing Atlas configuration.
MONGODB_URI=mongodb+srv://YOUR_ATLAS_CONFIGURATION
MONGODB_DATABASE=organsync_v2_logs

# Writes are blocked by default and always blocked in production.
# For local fictional-data CRUD only, set true and supply a random token of 32+ characters.
# Enter the same token in the management page; it stays in memory, not browser storage.
ORGANSYNC_DEV_WRITES=false
ORGANSYNC_DEV_WRITE_TOKEN=

# Additional explicit opt-in for fixed SQL demonstrations; every fixture is rolled back.
ORGANSYNC_DEV_DB_DEMO=false

# Atlas secondary database; configure secrets only in .env.local
ORGANSYNC_SYNC_SOURCE=organsync_v2
ORGANSYNC_SYNC_WORKER_ENABLED=false
ORGANSYNC_DEV_SYNC=false
# Approved minimal business read models; run controlled backfill before enabling workers.
ORGANSYNC_BUSINESS_PROJECTIONS=false
